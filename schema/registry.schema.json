{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "updatedAt": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "homepage": {
            "type": "string",
            "format": "uri"
          },
          "latest": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
                },
                "engines": {
                  "type": "object",
                  "properties": {
                    "app": {
                      "type": "string"
                    },
                    "pluginApi": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "app",
                    "pluginApi"
                  ],
                  "additionalProperties": false
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "platform": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "signature": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "platform",
                      "url",
                      "sha256",
                      "signature"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "version",
                "engines",
                "artifacts"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "displayName",
          "description",
          "publisher",
          "latest",
          "versions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "updatedAt",
    "plugins"
  ],
  "additionalProperties": false
}
